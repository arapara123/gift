{
  "name": "gift",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/img/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portalgame",
      "database_id": "b096fff3-bfd4-4dab-929a-257743a5c8f1"
    }
  ],
  "vars": {
    "BOT_USERNAME": "ВПИШИ_ЮЗЕРНЕЙМ_БОТА",
    "APP_SHORTNAME": ""
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
